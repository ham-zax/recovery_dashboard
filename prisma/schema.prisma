generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "sqlite"
}

model DailyLog {
  id                  Int      @id @default(autoincrement())
  date                DateTime @unique
  pain                Int // 0-10
  reflux              Int // 0-10
  walkedToday         Boolean
  strengthToday       Boolean
  sleepHours          Float
  sittingBreaksActual Int      @default(0)
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  protocolId          Int
  protocol            Protocol @relation(fields: [protocolId], references: [id])
}

model WorkoutSession {
  id         Int             @id @default(autoincrement())
  date       DateTime
  type       String // LOWER | UPPER
  notes      String?
  entries    ExerciseEntry[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  protocolId Int
  protocol   Protocol        @relation(fields: [protocolId], references: [id])
}

model ExerciseEntry {
  id         Int            @id @default(autoincrement())
  sessionId  Int
  exerciseId Int
  setNumber  Int
  weight     Float? // kg
  reps       Int
  rpe        Int? // 1-10
  session    WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise   Exercise       @relation(fields: [exerciseId], references: [id])
  createdAt  DateTime       @default(now())
}

model Exercise {
  id        Int             @id @default(autoincrement())
  name      String
  category  String // LOWER | UPPER
  sortOrder Int
  active    Boolean         @default(true)
  entries   ExerciseEntry[]
  createdAt DateTime        @default(now())
}

model WeeklyReview {
  id                Int      @id @default(autoincrement())
  weekStarting      DateTime @unique
  compliancePercent Float
  avgPain           Float
  avgReflux         Float
  totalWalks        Int
  totalWorkouts     Int
  avgSleep          Float
  avgSittingBreaks  Float    @default(0)
  aiSummary         String?
  manualNotes       String?
  nextWeekFocus     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ProtocolLock {
  id          Int      @id @default(autoincrement())
  version     String // e.g. v1.0
  lockedUntil DateTime
  description String?
  createdAt   DateTime @default(now())
}

model Protocol {
  id              Int              @id @default(autoincrement())
  version         String           @unique
  walkingTarget   Int              @default(1)
  sittingTarget   Int              @default(10)
  recoveryWeights String? // Stored as JSON string
  workoutSchedule String           @default("{\"mon\":\"LOWER\",\"tue\":\"UPPER\",\"wed\":\"REST\",\"thu\":\"LOWER\",\"fri\":\"UPPER\",\"sat\":\"REST\",\"sun\":\"REST\"}")
  active          Boolean          @default(false)
  startedAt       DateTime         @default(now())
  endedAt         DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  logs            DailyLog[]
  workouts        WorkoutSession[]

  changesFrom ProtocolChange[] @relation("FromProtocol")
  changesTo   ProtocolChange[] @relation("ToProtocol")

  clonedFromId Int?
  clonedFrom   Protocol?  @relation("ProtocolClones", fields: [clonedFromId], references: [id])
  clones       Protocol[] @relation("ProtocolClones")

  @@unique([active], name: "unique_active_protocol", map: "unique_active_protocol", where: { active: true })
}

model ProtocolChange {
  id             Int      @id @default(autoincrement())
  fromProtocolId Int
  toProtocolId   Int
  changedAt      DateTime @default(now())
  reason         String?
  notes          String? // Document detailed reasoning behind configuration shifts
  changes        String // Stored as JSON string

  fromProtocol Protocol @relation("FromProtocol", fields: [fromProtocolId], references: [id])
  toProtocol   Protocol @relation("ToProtocol", fields: [toProtocolId], references: [id])
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
